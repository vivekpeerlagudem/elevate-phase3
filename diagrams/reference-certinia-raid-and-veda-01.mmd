    RISK }o--o| ISSUE : "Issue lookup / Risk lookup"

    RISK {
        text Risk_Name
        picklist Status
        picklist Impact
        picklist Likelihood
        formula Severity
        lookup Project
        lookup Issue
    }

    ISSUE {
        text Issue_Name
        picklist Status
        picklist Impact
        picklist Priority
        formula Severity
        lookup Project
        lookup Risk
    }

    ACTION {
        text Action_Name
        picklist Status
        date Completed_Date
        lookup Project
    }

    ASSUMPTION {
        text Assumption_Name
        picklist Status
        picklist Impact
        picklist Likelihood
        formula Severity
        lookup Project
    }

    DECISION {
        text Decision_Name
        picklist Status
        picklist Impact
        picklist Priority
        formula Severity
        date Approved_Date
        lookup Project
    }

    DEPENDENCY {
        text Dependency_Name
        picklist Status
        text Impact_Analysis
        lookup Project
    }
